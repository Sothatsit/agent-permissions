      "node -h": "Read-only",
      "npm --help": "Read-only",
      "npm --version": "Read-only",
      "npm list:*": "Read-only",
      "npm outdated:*": "Read-only",
      "npm view:*": "Read-only",
      "npm info:*": "Read-only",
      "pnpm --help": "Read-only",
      "pnpm --version": "Read-only",
      "pnpm list:*": "Read-only",
      "bun --help": "Read-only",
      "bun --version": "Read-only",
      "bun list:*": "Read-only",
      "gcc:*": "Build toolchain",
      "g++:*": "Build toolchain",
