  "SoftAsk": {
    "Commands": {
      "pip install:*": "installs packages",
      "pip uninstall:*": "removes packages",
      "pip3 install:*": "installs packages",
      "pip3 uninstall:*": "removes packages",
      "python -m pip install:*": "installs packages",
      "python -m pip uninstall:*": "removes packages",
      "python3 -m pip install:*": "installs packages",
      "python3 -m pip uninstall:*": "removes packages",
      "npm install:*": "installs packages",
      "npm uninstall:*": "removes packages",
      "pnpm install:*": "installs packages",
      "pnpm remove:*": "removes packages",
      "bun install:*": "installs packages",
      "bun remove:*": "removes packages",
      "npx:*": "runs arbitrary remote npm package",
      "conda config:*": "edits conda config",
      "conda install:*": "installs packages into env",
      "conda update:*": "updates packages in env",
      "conda create:*": "creates a new env",
      "conda remove:*": "removes packages from env",
      "micromamba config:*": "edits micromamba config",
