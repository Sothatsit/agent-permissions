      "pip --version": "Read-only",
      "pip list:*": "Read-only",
      "pip show:*": "Read-only",
      "pip freeze:*": "Read-only",
      "pip check": "Read-only",
      "pip3 --help": "Read-only",
      "pip3 --version": "Read-only",
      "pip3 list:*": "Read-only",
      "pip3 show:*": "Read-only",
      "pip3 freeze:*": "Read-only",
      "pip3 check": "Read-only",
      "pytest:*": "Build toolchain",
      "ruff:*": "Local changes",
      "mypy:*": "Read-only",
      "flake8:*": "Read-only",
      "pylint:*": "Read-only",
      "black:*": "Local changes",
      "isort:*": "Local changes",
      "perl --version": "Read-only",
      "perl --help": "Read-only",
      "perl -v": "Read-only",
      "perl -h": "Read-only",
