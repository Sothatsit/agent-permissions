{
  "description": "Language toolchains, interpreters, and environment managers. Covers Python, Perl, Ruby, Node, C/C++, Go, Rust, Java, .NET, and Conda. Interpreters allow only info flags (--version, --help) at the pattern layer; the hook scans scripts and inline code for dangerous patterns. Disabling this is the way to stop the agent executing arbitrary code in these languages.",
  "Allow": {
    "Commands": {
      "python --version": "Read-only",
      "python --help": "Read-only",
      "python -V": "Read-only",
      "python -h": "Read-only",
      "python3 --version": "Read-only",
      "python3 --help": "Read-only",
      "python3 -V": "Read-only",
      "python3 -h": "Read-only",
