      "gradle:*": "Build toolchain",
      "mvn:*": "Build toolchain",
      "./gradlew:*": "Build toolchain",
      "dotnet:*": "Build toolchain",
      "conda activate:*": "Local changes",
      "conda deactivate": "Local changes",
      "conda env:*": "Local changes",
