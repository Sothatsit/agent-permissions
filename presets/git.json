{
  "description": "Git, GitHub CLI, and pre-commit. Reads and staging are allowed; local writes are SoftAsk; push and gh writes are Ask; auth-credential commands are Deny. The Rules layer owns git remote/branch/tag and gh api (read vs write classification).",
  "Allow": {
    "Commands": {
      "git status:*": "",
      "git log:*": "",
      "git diff:*": "",
      "git show:*": "",
      "git ls-files:*": "",
      "git rev-parse:*": "",
      "git merge-base:*": "",
      "git blame:*": "",
      "git shortlog:*": "",
      "git check-ignore:*": "",
      "git reflog:*": "",
      "git describe:*": "",
      "git format-patch:*": "",
      "git ls-tree:*": "",
      "git grep:*": "",
      "git ls-remote:*": "",
      "git submodule status:*": "",
      "git cat-file:*": "",
      "git add:*": "",
      "git mv:*": "",
      "git fetch:*": "",
      "git pull": "no-arg pull only — pull with args is a soft-ask via the pattern below",
      "gh pr view:*": "",
      "gh pr diff:*": "",
      "gh pr list:*": "",
      "gh pr checks:*": "",
      "gh pr status:*": "",
      "gh issue view:*": "",
      "gh issue list:*": "",
      "gh search:*": "",
      "gh repo view:*": "",
      "gh repo list:*": "",
      "gh run list:*": "",
      "gh run view:*": "",
      "gh run watch:*": "",
      "gh run download:*": "",
      "gh workflow list:*": "",
      "gh workflow view:*": "",
      "gh label list:*": "",
      "gh auth status:*": "",
      "gh release list:*": "",
      "gh release view:*": "",
      "pre-commit:*": ""
    }
  },
  "SoftAsk": {
    "Commands": {
      "git commit:*": "local commit",
      "git rm:*": "deletes files",
      "git apply:*": "applies a patch",
      "git checkout:*": "can change working tree state",
      "git switch:*": "branch switch — can lose uncommitted work",
      "git restore:*": "discards working-tree changes",
      "git stash:*": "may pop/drop stashes",
      "git rebase:*": "rewrites history",
      "git merge:*": "merge commit, may conflict",
      "git pull *": "with args can fetch from non-default refs",
      "git reset:*": "can discard work",
      "git cherry-pick:*": "applies arbitrary commits",
      "git revert:*": "creates revert commit",
      "git config:*": "edits git config",
      "git worktree:*": "creates auxiliary working trees",
      "git clean:*": "deletes untracked files"
    }
  },
  "Ask": {
    "Commands": {
      "git push:*": "publishes commits to a remote",
      "gh repo clone:*": "writes a new directory",
      "gh repo fork:*": "creates a repo on GitHub",
      "gh pr create:*": "creates a PR on GitHub",
      "gh pr merge:*": "merges a PR",
      "gh pr close:*": "closes a PR",
      "gh pr reopen:*": "reopens a PR",
      "gh pr ready:*": "marks a PR ready for review",
      "gh pr comment:*": "comments on a PR",
      "gh pr edit:*": "edits PR metadata",
      "gh pr review:*": "submits a review",
      "gh pr checkout:*": "checks out a PR locally",
      "gh co:*": "alias for gh pr checkout in many configs",
      "gh issue create:*": "creates an issue",
      "gh issue close:*": "closes an issue",
      "gh issue reopen:*": "reopens an issue",
      "gh issue delete:*": "deletes an issue",
      "gh issue comment:*": "comments on an issue",
      "gh issue edit:*": "edits issue metadata",
      "gh run cancel:*": "cancels a workflow run",
      "gh run rerun:*": "reruns a workflow run",
      "gh workflow run:*": "triggers a workflow",
      "gh release create:*": "creates a release",
      "gh release edit:*": "edits release metadata",
      "gh release delete:*": "deletes a release"
    }
  },
  "Deny": {
    "Commands": {
      "gh auth login:*": "modifies stored credentials",
      "gh auth logout:*": "modifies stored credentials",
      "gh auth refresh:*": "modifies stored credentials",
      "gh auth switch:*": "switches active credentials",
      "gh ssh-key:*": "manages SSH keys",
      "gh gpg-key:*": "manages GPG keys",
      "gh extension install:*": "loads third-party code",
      "gh extension remove:*": "removes installed extensions",
      "gh secret:*": "manages repo or org secrets"
    }
  }
}
